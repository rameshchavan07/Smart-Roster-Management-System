# ---------- Backend ----------
APP_ENV=local                     # local | test | production
DATABASE_URL=postgresql+psycopg://rosterops:rosterops@localhost:5432/rosterops
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_S=30
DB_POOL_RECYCLE_S=1800
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
CORS_ORIGINS=http://localhost:5173        # comma-separated allow-list
SOLVER_TIME_LIMIT_S=20
SOLVER_SEED=42
LOG_LEVEL=INFO
SEED_ON_START=false                       # true only for the first demo deploy
DEMO_PASSWORD=change-me-at-deploy-time    # used by the seed script for demo accounts

# ---------- Frontend (build-time) ----------
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ---------- Local database container ----------
POSTGRES_USER=rosterops
POSTGRES_PASSWORD=rosterops
POSTGRES_DB=rosterops
